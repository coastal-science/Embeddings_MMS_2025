   "source": [
    "import os\n",
    "# get all train files used for the paper experiment:\n",
    "original_splits = [os.path.join(root_path + str(i), f\"birdnet0{i}.csv\") for i in range(1, 10)]\n",
    "original_reconstructed_splits = [os.path.join(\"original_splits\", f\"train_birdnet0{i}.csv\") for i in range(1,10)]\n",
    "reconstructed_dfs = []\n",
    "print(original_splits)\n",
    "print(reconstructed_splits)\n",
    "for i, (o, r) in enumerate(zip(original_splits, original_reconstructed_splits)):\n",
    "    try:\n",
    "        original = pd.read_csv(o)\n",
    "        reconstructed = pd.read_csv(r)\n",
    "        # print(\"o - r:\", set(original.columns) - set(reconstructed.columns))\n",
    "        # print(\"r - o:\", set(reconstructed.columns) - set(original.columns))\n",
    "        reconstructed = reconstructed[list(original.columns)]\n",
    "        reconstructed['Duration'] = reconstructed['Duration'].round(3)\n",
    "        original['Duration'] = original['Duration'].round(3)\n",
    "        # print(\"r - o:\", set(reconstructed.columns) - set(original.columns))\n",
    "        print(f\"########## split 0{i+1} ##########\")\n",
    "        comparison = (original == reconstructed) | (original.isna() & reconstructed.isna())\n",
    "        print(\"original == reconstructed:\", comparison.all().all())\n",
    "        reconstructed_dfs.append([r, reconstructed])\n",
    "    except:\n",
    "        continue"
   ]
  },
