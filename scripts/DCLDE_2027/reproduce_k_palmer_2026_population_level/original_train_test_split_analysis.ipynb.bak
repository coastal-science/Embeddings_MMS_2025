   "source": [
    "import pandas as pd, numpy as np\n",
    "print(\"unique_datasets_in_holdout:\", repr(list(unique_datasets_in_holdout)))\n",
    "print(\"dtype:\", unique_datasets_in_holdout.dtype, \" len:\", len(unique_datasets_in_holdout))\n",
    "print(\"any NaN:\", any(pd.isna(d) for d in unique_datasets_in_holdout))\n",
    "\n",
    "files = birdnet01_DCLDE_eval[\"File\"]\n",
    "print(\"\\nFile dtype:\", files.dtype, \" n:\", len(files))\n",
    "print(\"non-str File values:\", files[~files.map(lambda v: isinstance(v, str))].tolist()[:10])\n",
    "\n",
    "mask_ok = files.apply(lambda x: any(ds in x for ds in unique_datasets_in_holdout if isinstance(ds, str) and isinstance(x, str)))\n",
    "print(\"\\nrows with NO matching dataset:\", (~mask_ok).sum())\n",
    "print(files[~mask_ok].head(20).tolist())"
   ]
  }
