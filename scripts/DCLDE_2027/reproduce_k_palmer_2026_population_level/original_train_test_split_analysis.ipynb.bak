      "TKW                  1381       1373.0\n",
      "birdnet08_DCLDE_eval.csv\n",
      "            reconstructed  paper_truth\n",
      "Background           4742       4538.0\n",
      "HW                  25071      25071.0\n",
      "KW_und                489          NaN\n",
      "SRKW                 3944       3692.0\n",
      "TKW                  1381       1373.0\n",
      "birdnet09_DCLDE_eval.csv\n",
      "            reconstructed  paper_truth\n",
      "Background           4742       4538.0\n",
      "HW                  25071      25071.0\n",
      "KW_und                489          NaN\n",
      "SRKW                 3944       3692.0\n",
      "TKW                  1381       1373.0\n"
     ]
    }
   ],
   "source": [
    "eval_csvs = [f\"birdnet{i:02d}_DCLDE_eval.csv\" for i in range(1, 10)]\n",
    "\n",
    "for name in eval_csvs:\n",
    "    birdnet_eval = pd.read_csv(\"~/KillerWhaleAcousticClassification/Results/\" + name)\n",
    "    stems = set(\n",
    "        birdnet_eval[\"File\"]\n",
    "        .apply(lambda f: Path(m.group(1)).stem.lower() if (m := PAT.match(f)) else None)\n",
    "        .dropna()\n",
    "    )\n",
    "    holdout_eval_correct = annotations_w_calltypes[anno_stems.isin(stems)].reset_index(drop=True)\n",
    "    print(name)\n",
    "    print(pd.DataFrame({\n",
    "        \"reconstructed\": holdout_eval_correct[\"Labels\"].value_counts(),\n",
    "        \"paper_truth\": birdnet_eval[\"Truth\"].value_counts(),\n",
    "    }))"
   ]
  },
