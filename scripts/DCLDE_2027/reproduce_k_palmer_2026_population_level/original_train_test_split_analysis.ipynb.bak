   "source": [
    "import os\n",
    "# get all train files used for the paper experiment:\n",
    "exp_csv_paths = [os.path.join(root_path + str(i), f\"birdnet0{i}.csv\") for i in range(1, 10)]\n",
    "print(exp_csv_paths)\n",
    "train_soundfiles = []\n",
    "for csv_path in exp_csv_paths:\n",
    "    try:\n",
    "        csv_df = pd.read_csv(csv_path)\n",
    "        train_soundfiles+=list(csv_df[\"Soundfile\"])\n",
    "    except:\n",
    "        continue\n",
    "\n",
    "len(set(train_soundfiles))\n",
    "len(set(local_eval_files))\n",
    "print(\"There is overlap between the train and local test files: \", bool(set(train_soundfiles).intersection(set(local_eval_files))))\n",
    "print(\"There is overlap between the train and paper test files: \", bool(set(train_soundfiles).intersection(set(paper_eval_files))))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a04c89c2",
   "metadata": {},
   "source": [
    "so we confirm there is no overal between the training set and the evaluation set! "
   ]
  },
