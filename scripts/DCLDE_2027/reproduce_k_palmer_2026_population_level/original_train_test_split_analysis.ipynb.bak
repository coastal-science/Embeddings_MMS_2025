   "source": [
    "updated_holdout_eval  = annotations_w_calltypes[list(holdout_eval.drop(columns=['annotations_index']).columns) + ['Labels']]\n",
    "\n",
    "indexes = list(birdnet01_DCLDE_eval[\"annotations_index\"])\n",
    "# keep the same rows as the original eval set.\n",
    "updated_holdout_eval = updated_holdout_eval.iloc[indexes]\n",
    "updated_holdout_eval = updated_holdout_eval.reset_index()\n",
    "updated_holdout_eval['annotations_index'] = updated_holdout_eval['index']\n",
    "updated_holdout_eval = updated_holdout_eval.drop(columns=['index'])\n",
    "updated_holdout_eval['Labels']"
   ]
  },
