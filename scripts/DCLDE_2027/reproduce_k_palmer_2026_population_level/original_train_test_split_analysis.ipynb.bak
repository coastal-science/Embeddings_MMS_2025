     "output_type": "execute_result"
    }
   ],
   "source": [
    "len(set(local_eval_files).intersection(set(paper_eval_files)))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0489b141",
   "metadata": {},
   "source": [
    "We see here that there is 100% overlap at the file level. Next step is to verify that this is true at the annotation level."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "8e6eded1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "all files have a ds in the new holdout set: True\n",
      "0 unmatched\n",
      "[]\n"
     ]
    }
   ],
   "source": [
    "unique_datasets_in_holdout = holdout_eval[\"Dataset\"].unique()\n",
    "\n",
    "# check that one of these datasets are in every one of the files present in the original paper set:\n",
    "check_ds_in_file = lambda x: any(ds in x for ds in unique_datasets_in_holdout)\n",
    "# get_ds = lambda x: next(iter((ds for ds in unique_datasets_in_holdout if ds in x)))\n",
    "def get_ds(x):\n",
    "    if not isinstance(x, str):\n",
    "        return pd.NA\n",
    "    return next((ds for ds in unique_datasets_in_holdout\n",
    "                 if isinstance(ds, str) and ds in x), pd.NA)\n",
    "print(\"all files have a ds in the new holdout set:\", birdnet01_DCLDE_eval[\"File\"].apply(check_ds_in_file).sum() == len(birdnet01_DCLDE_eval[\"File\"]))\n",
    "# create dataset row\n",
    "birdnet01_DCLDE_eval[\"Dataset\"] = birdnet01_DCLDE_eval[\"File\"].apply(get_ds)\n",
    "# print(birdnet01_DCLDE_eval[\"Dataset\"])\n",
    "print(birdnet01_DCLDE_eval[\"Dataset\"].isna().sum(), \"unmatched\")\n",
    "print(birdnet01_DCLDE_eval.loc[birdnet01_DCLDE_eval[\"Dataset\"].isna(), \"File\"].tolist())"
   ]
  },
