   "source": [
    "print(len(annotations_w_calltypes))\n",
    "print(len(annotations))\n",
    "# align cols and confirm they are the same (annotations now loads with clean column names)\n",
    "common = list(annotations.columns)\n",
    "n = min(len(annotations), len(annotations_w_calltypes))\n",
    "a = annotations[common].iloc[:n].reset_index(drop=True)\n",
    "a_w_c = annotations_w_calltypes[common].iloc[:n].reset_index(drop=True)\n",
    "\n",
    "comparison = (a == a_w_c) | (a.isna() & a_w_c.isna())\n",
    "comparison.all()"
   ]
  },
