     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "local_eval_files = holdout_eval[\"Soundfile\"].apply(lambda x: x.replace(\".flac\", \"\").replace(\".wav\", \"\"))\n",
    "len(set(local_eval_files))"
   ]
  },
