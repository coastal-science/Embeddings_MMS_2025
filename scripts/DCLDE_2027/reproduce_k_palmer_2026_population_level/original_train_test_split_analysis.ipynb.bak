{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "abd99c3d",
   "metadata": {},
   "source": [
    "The purpose of this notebook is to analyze the original train / test split to understand how it was stratified. \n",
    "\n",
    "Initial understanding: \n",
    "- Eval set consists of 20% of each individual deployment. (\"Dataset\" columns)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "a7f3eac2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['Soundfile', 'Dataset', 'LowFreqHz', 'HighFreqHz', 'FileEndSec', 'UTC',\n",
       "       'FileBeginSec', 'ClassSpecies', 'KW', 'KW_certain', 'Ecotype',\n",
       "       'Provider', 'AnnotationLevel', 'FilePath', 'FileOk'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import os\n",
    "# Annotations.csv was written by R's write.csv (unnamed row-index column, all header\n",
    "# names quoted, CRLF) and has a stray leading backtick on the header line, which breaks\n",
    "# pandas' quote handling for column 0 -> it comes in as `\"\"` instead of `Unnamed: 0`.\n",
    "# Drop that column and strip any stray quote/backtick chars off the remaining names.\n",
    "annotations = pd.read_csv(\"/data/DCLDE_2027/dclde_2027_killer_whales/Annotations.csv\", index_col=0)\n",
    "annotations.index.name = None\n",
    "annotations.columns = annotations.columns.str.strip('`\"\\'')\n",
    "output_dir = \"./reconstructed_splits\"\n",
    "if not os.path.isdir(\"./reconstructed_splits\"):\n",
    "    os.mkdir(output_dir)\n",
    "root_path = \"~/KillerWhaleAcousticClassification/BirdNET Models/birdnet0\"\n",
    "annotations.columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d7c22d75",
   "metadata": {},
   "outputs": [
