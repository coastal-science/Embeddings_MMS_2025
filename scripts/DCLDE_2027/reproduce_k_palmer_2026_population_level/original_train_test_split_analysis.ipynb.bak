   "source": [
    "# Build 80-% Train set and Final Check: Is the rest of the full dataset (80%) data leak free?\n",
    "\n",
    "I will assume that the first set of experiments were not done properly. For this set we will generate the train set, by simply including all files which are not in the eval set.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "fa0603bf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'annotations_index'}\n",
      "{'Duration', 'EcotypeCertain', 'CenterTime', 'CalltypeHasQ', 'HasQ'}\n",
      "total: 207574\n",
      "holdout: 34674\n",
      "train: 172900\n",
      "holdout+train: 207574\n"
     ]
    }
   ],
   "source": [
    "holdout_eval = pd.read_csv(\"./reconstructed_splits/holdout_eval.csv\")\n",
    "holdout_eval = holdout_eval.drop(columns = [\"Unnamed: 0\"])\n",
    "print(set(holdout_eval.columns) - set(annotations_w_calltypes.columns))\n",
    "print(set(annotations_w_calltypes.columns) - set(holdout_eval.columns))\n",
    "annotations_w_calltypes['annotations_index'] = annotations_w_calltypes.index\n",
    "\n",
    "train_set = annotations_w_calltypes[list(holdout_eval.columns)]\n",
    "train_set = train_set[[list(train_set.columns)[-1]] + list(train_set.columns)[:-1]]\n",
    "train_set = train_set[~train_set[\"annotations_index\"].isin(set(holdout_eval[\"annotations_index\"]))]\n",
    "\n",
    "print(\"total:\", len(annotations_w_calltypes))\n",
    "print(\"holdout:\", len(holdout_eval))\n",
    "print(\"train:\", len(train_set))\n",
    "print(\"holdout+train:\", len(train_set) + len(holdout_eval))"
   ]
  },
